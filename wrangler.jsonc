{
  "name": "jazz",
  "compatibility_date": "2026-08-24",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalogo-jazz-db",
      "database_id": "3365bf01-e6f1-442d-88b7-a902143de877"
    }
  ]
}
